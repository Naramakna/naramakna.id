// backend/src/config/database.js

const { Sequelize } = require("sequelize");
require("dotenv").config();

const dbConfig = {
  host: process.env.DB_HOST,
  user: process.env.DB_USER,
  password: process.env.DB_PASSWORD,
  database: process.env.DB_NAME,
  dialect: "mysql",
  pool: {
    max: 20,        // Increased from 5 to 20 (2 instances = 40 total connections available)
    min: 2,         // Keep 2 idle connections ready for quick access
    acquire: 60000, // Increased from 30s to 60s - time to wait for connection before timeout
    idle: 10000,    // Increased from 5s to 10s - release idle connections after 10 seconds
    evict: 5000,    // Check for idle connections every 5 seconds
    handleDisconnects: true
  },
  dialectOptions: {
    connectTimeout: 10000, // 10 seconds connection timeout
    timezone: "+07:00"     // WIB timezone (GMT+7)
  },
  timezone: "+07:00",      // Sequelize timezone for date parsing
  logging: false,
  retry: {
    max: 3          // Retry failed queries up to 3 times
  }
};

const sequelize = new Sequelize(
  dbConfig.database,
  dbConfig.user,
  dbConfig.password,
  {
    host: dbConfig.host,
    dialect: dbConfig.dialect,
    pool: dbConfig.pool,
    dialectOptions: dbConfig.dialectOptions,
    timezone: dbConfig.timezone,
    logging: dbConfig.logging
  }
);

module.exports = sequelize;
