const { sequelize } = require('../models');
const { QueryTypes } = require('sequelize');
const axios = require('axios');

require('dotenv').config();

class TrendingController {

  static async getTrendingTopics(req, res) {
    try {
      const cachedTopics = await TrendingController.getCachedTrendingTopics();

      if (cachedTopics && cachedTopics.length > 0) {
        res.json({
          success: true,
          data: { topics: cachedTopics, lastUpdated: new Date(), source: 'cache' }
        });
        return;
      }

      const freshTopics = await TrendingController.scrapeTrendingTopics();
      res.json({
        success: true,
        data: { topics: freshTopics, lastUpdated: new Date(), source: 'fresh' }
      });
    } catch (error) {
      console.error('Error getting trending topics:', error);
      res.status(500).json({ success: false, message: 'Failed to get trending topics', error: error.message });
    }
  }

  static async updateTrendingTopics(req, res) {
    try {
      console.log('🔄 Updating trending topics...');
      const startTime = Date.now();

      const topics = await TrendingController.scrapeTrendingTopics();
      const matchedArticles = await TrendingController.matchArticlesWithTrending(topics);
      await TrendingController.cacheTrendingResults(matchedArticles);

      const duration = ((Date.now() - startTime) / 1000).toFixed(1);
      console.log(`✅ Trending update completed in ${duration}s`);

      res.json({
        success: true,
        data: { topicsFound: topics.length, articlesMatched: matchedArticles.length, duration: duration + 's', updatedAt: new Date() }
      });
    } catch (error) {
      console.error('Error updating trending topics:', error);
      res.status(500).json({ success: false, message: 'Failed to update trending topics', error: error.message });
    }
  }

  // OPTIMIZED: Parallel RSS fetching
  static async scrapeTrendingTopics() {
    console.log('⚡ Fetching trending topics (optimized)...');

    // Fetch all sources in parallel with timeout
    const [googleTrends, newsTopics, socialTopics] = await Promise.all([
      TrendingController.getGoogleTrendsIndonesia().catch(() => []),
      TrendingController.getNewsAggregatorTopics().catch(() => []),
      TrendingController.getSocialMediaTrends().catch(() => [])
    ]);

    const allTopics = [...googleTrends, ...newsTopics, ...socialTopics];
    const uniqueTopics = TrendingController.deduplicateTopics(allTopics);

    console.log(`📊 Found ${uniqueTopics.length} unique topics`);
    return uniqueTopics.slice(0, 30);
  }

  static async getGoogleTrendsIndonesia() {
    try {
      const response = await axios.get('https://trends.google.com/trends/trendingsearches/daily/rss?geo=ID', {
        timeout: 5000,
        headers: { 'User-Agent': 'Mozilla/5.0 (compatible; NewsBotIndonesia/1.0)' }
      });

      const trends = [];
      const matches = response.data.match(/<title><!\[CDATA\[(.*?)\]\]><\/title>/g);

      if (matches) {
        matches.forEach(match => {
          const title = match.replace(/<title><!\[CDATA\[/, '').replace(/\]\]><\/title>/, '');
          if (title && title.length > 3 && !title.includes('Google Trends')) {
            trends.push({ keyword: title.toLowerCase(), source: 'google_trends', weight: 10 });
          }
        });
      }
      return trends.slice(0, 15);
    } catch (error) {
      return [];
    }
  }

  // OPTIMIZED: Parallel news fetching
  static async getNewsAggregatorTopics() {
    const newsSources = [
      'https://www.detik.com/terpopuler/feed/',
      'https://nasional.kompas.com/rss/',
      'https://www.cnnindonesia.com/nasional/rss'
    ];

    const results = await Promise.all(
      newsSources.map(async (source) => {
        try {
          const response = await axios.get(source, { timeout: 3000, headers: { 'User-Agent': 'Mozilla/5.0' } });
          const topics = [];
          const matches = response.data.match(/<title><!\[CDATA\[(.*?)\]\]><\/title>/g);

          if (matches) {
            matches.slice(0, 5).forEach(match => {
              const title = match.replace(/<title><!\[CDATA\[/, '').replace(/\]\]><\/title>/, '');
              const keywords = TrendingController.extractKeywordsFromTitle(title);
              keywords.forEach(kw => topics.push({ keyword: kw.toLowerCase(), source: 'news', weight: 5 }));
            });
          }
          return topics;
        } catch { return []; }
      })
    );

    return results.flat();
  }

  static async getSocialMediaTrends() {
    return [
      { keyword: 'politik indonesia', source: 'social', weight: 3 },
      { keyword: 'ekonomi nasional', source: 'social', weight: 3 },
      { keyword: 'teknologi', source: 'social', weight: 2 }
    ];
  }

  static extractKeywordsFromTitle(title) {
    if (!title || title.length < 5) return [];
    const stopWords = ['yang', 'dan', 'di', 'ke', 'dari', 'untuk', 'pada', 'dengan', 'oleh', 'dalam', 'akan', 'adalah', 'ini', 'itu', 'tidak', 'juga', 'atau'];
    const words = title.toLowerCase().replace(/[^\w\s]/g, ' ').split(/\s+/).filter(w => w.length > 3 && !stopWords.includes(w));
    return words.slice(0, 3);
  }

  static deduplicateTopics(topics) {
    const seen = new Map();
    topics.forEach(t => {
      const key = t.keyword.trim().toLowerCase();
      if (seen.has(key)) { seen.get(key).weight += t.weight; }
      else { seen.set(key, { ...t, keyword: key }); }
    });
    return Array.from(seen.values()).sort((a, b) => b.weight - a.weight);
  }

  // OPTIMIZED: Single batch query, only search title (not content)
  static async matchArticlesWithTrending(trendingTopics) {
    try {
      const limitedTopics = trendingTopics.slice(0, 15); // Reduced from 30 to 15
      console.log(`⚡ Processing ${limitedTopics.length} topics`);

      // Build OR conditions for all keywords - search TITLE only (fast)
      const keywords = limitedTopics.map(t => t.keyword);
      const searchConditions = keywords.map(kw => {
        const escaped = kw.replace(/'/g, "''").replace(/"/g, '\\"');
        return `LOWER(p.post_title) LIKE '%${escaped}%'`;
      }).join(' OR ');

      // Single optimized query
      const query = `
        SELECT
          p.ID,
          p.post_title,
          p.post_name,
          p.post_excerpt,
          p.post_date,
          COALESCE(p.view_count, 0) as view_count,
          u.display_name as author_name,
          attachment.guid as thumbnail_url
        FROM posts p
        LEFT JOIN users u ON p.post_author = u.ID
        LEFT JOIN postmeta thumb ON p.ID = thumb.post_id AND thumb.meta_key = '_thumbnail_id'
        LEFT JOIN posts attachment ON thumb.meta_value = attachment.ID
        WHERE p.post_status = 'publish'
        AND p.post_type = 'post'
        AND (${searchConditions})
        ORDER BY p.post_date DESC
        LIMIT 50
      `;

      const articles = await sequelize.query(query, { type: QueryTypes.SELECT });

      // Match articles with best keyword
      const matchedArticles = articles.map(article => {
        const title = (article.post_title || '').toLowerCase();
        let bestTopic = limitedTopics[0];
        let bestMatch = false;

        for (const topic of limitedTopics) {
          if (title.includes(topic.keyword)) {
            bestTopic = topic;
            bestMatch = true;
            break;
          }
        }

        return {
          ...article,
          trending_keyword: bestTopic.keyword,
          trending_weight: bestTopic.weight,
          trending_source: bestTopic.source,
          relevance_score: TrendingController.calculateRelevanceScore(article, bestTopic)
        };
      });

      // Sort and dedupe
      const uniqueArticles = new Map();
      matchedArticles.forEach(a => {
        if (!uniqueArticles.has(a.ID) || uniqueArticles.get(a.ID).relevance_score < a.relevance_score) {
          uniqueArticles.set(a.ID, a);
        }
      });

      return Array.from(uniqueArticles.values())
        .sort((a, b) => b.relevance_score - a.relevance_score)
        .slice(0, 20);

    } catch (error) {
      console.error('Error matching articles:', error);
      return [];
    }
  }

  static calculateRelevanceScore(article, topic) {
    let score = topic.weight * 10;
    const daysDiff = (new Date() - new Date(article.post_date)) / (1000 * 60 * 60 * 24);
    if (daysDiff <= 7) score += (7 - daysDiff) * 5;
    score += Math.min(article.view_count || 0, 1000) / 10;
    if ((article.post_title || '').toLowerCase().includes(topic.keyword)) score += 50;
    return Math.round(score);
  }

  static async cacheTrendingResults(articles) {
    try {
      const fs = require('fs').promises;
      const path = require('path');
      const cacheDir = path.join(__dirname, '../cache');
      const cacheFile = path.join(cacheDir, 'trending_topics.json');

      await fs.mkdir(cacheDir, { recursive: true }).catch(() => {});
      await fs.writeFile(cacheFile, JSON.stringify({
        articles, timestamp: new Date(), expires: new Date(Date.now() + 24 * 60 * 60 * 1000)
      }, null, 2));

      console.log('✅ Trending cached');
    } catch (error) {
      console.error('Cache error:', error);
    }
  }

  static async getCachedTrendingTopics() {
    try {
      const fs = require('fs').promises;
      const path = require('path');
      const data = await fs.readFile(path.join(__dirname, '../cache/trending_topics.json'), 'utf8');
      const cache = JSON.parse(data);
      if (new Date() < new Date(cache.expires)) return cache.articles;
      return null;
    } catch { return null; }
  }

  static async getTrendingArticles(req, res) {
    try {
      const { limit = 10, category } = req.query;
      let articles = await TrendingController.getCachedTrendingTopics() || [];

      if (category) {
        articles = articles.filter(a =>
          (a.post_title || '').toLowerCase().includes(category.toLowerCase())
        );
      }

      res.json({
        success: true,
        data: { posts: articles.slice(0, parseInt(limit)), totalItems: articles.length, criteria: 'trending', lastUpdated: new Date() }
      });
    } catch (error) {
      res.status(500).json({ success: false, message: 'Failed', error: error.message });
    }
  }
}

module.exports = TrendingController;
