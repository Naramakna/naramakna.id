// backend/src/config/database.js

const { Sequelize } = require('sequelize');
require('dotenv').config();

const dbConfig = {
  host: process.env.DB_HOST,
  user: process.env.DB_USER,
  password: process.env.DB_PASSWORD,
  database: process.env.DB_NAME,
  dialect: 'mysql',
  pool: {
    max: 5,         // Reduced for better connection management (2 instances = 10 total connections)
    min: 0,         // No minimum idle connections
    acquire: 30000, // 30 seconds to acquire connection
    idle: 5000,     // Release idle connections after 5 seconds
    evict: 1000,    // Check for idle connections every 1 second
    handleDisconnects: true
  },
  dialectOptions: {
    connectTimeout: 10000 // 10 seconds connection timeout
  },
  logging: false,
  retry: {
    max: 3          // Retry failed queries up to 3 times
  }
};

const sequelize = new Sequelize(
  dbConfig.database,
  dbConfig.user,
  dbConfig.password,
  {
    host: dbConfig.host,
    dialect: dbConfig.dialect,
    pool: dbConfig.pool,
    logging: dbConfig.logging
  }
);

module.exports = sequelize;